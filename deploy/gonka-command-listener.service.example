[Unit]
Description=Gonka host-bot snapshot commands
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gonka-monitor
Group=gonka-monitor
WorkingDirectory=/opt/gonka-host-bot
EnvironmentFile=/etc/gonka-host-bot.env
ExecStart=/opt/gonka-host-bot/.venv/bin/python command_listener.py
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
