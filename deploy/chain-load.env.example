# Copy to /etc/gonka-chain-load.env and replace every placeholder.
CHAIN_LOAD_MODE=daemon
CHAIN_LOAD_POLL_INTERVAL_SECONDS=60
# Optional comma-separated override; remove to use config/chain_load.json.
CHAIN_LOAD_RPC_URLS=https://node1.gonka.ai/chain-rpc,https://node2.gonka.ai/chain-rpc,https://node3.gonka.ai/chain-rpc,http://204.12.168.157:26657
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-chat-id
TELEGRAM_MESSAGE_THREAD_ID=replace-with-telegram-topic-id
# Optional; leave empty when a secondary channel is not used.
TELEGRAM_SECONDARY_CHAT_ID=
