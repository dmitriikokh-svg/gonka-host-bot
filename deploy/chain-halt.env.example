# Copy to /etc/gonka-chain-halt.env and replace every placeholder.
CHAIN_MONITOR_MODE=daemon
CHAIN_POLL_INTERVAL_SECONDS=30
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-chat-id
TELEGRAM_MESSAGE_THREAD_ID=replace-with-telegram-topic-id
# Optional; leave empty when a secondary channel is not used.
TELEGRAM_SECONDARY_CHAT_ID=
