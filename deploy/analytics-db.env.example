# Install as /etc/gonka-analytics-db.env with mode 0600.
# The SSH tunnel itself is managed outside this probe.
GONKA_ANALYTICS_DB_HOST=127.0.0.1
GONKA_ANALYTICS_DB_PORT=15432
GONKA_ANALYTICS_DB_NAME=gonka_analytics
GONKA_ANALYTICS_DB_USER=replace-with-read-only-user
GONKA_ANALYTICS_DB_PASSWORD=replace-with-read-only-password
GONKA_ANALYTICS_DB_CONNECT_TIMEOUT_SECONDS=10
GONKA_ANALYTICS_DB_STATEMENT_TIMEOUT_SECONDS=30
