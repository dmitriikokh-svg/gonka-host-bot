# Copy to /etc/gonka-host-bot.env (mode 640, group gonka-monitor).
# Do not enable systemd timers while GitHub Actions still sends Telegram.

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_MESSAGE_THREAD_ID=
# TELEGRAM_SECONDARY_CHAT_ID=
# ETHEREUM_RPC_URLS=

TARGET_API_VERSION=v0.2.15-post3
TARGET_MLNODE_VERSION=3.0.16
ADOPTION_PERCENT=80
CHAIN_MONITOR_MODE=once
CHAIN_LOAD_MODE=once
